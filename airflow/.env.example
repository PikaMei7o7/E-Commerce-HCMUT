# Copy to airflow/.env (cp .env.example .env) and change the password.
# Database settings (DB_HOST, DB_NAME, ...) are NOT here: they are read from the
# project's root .env (../.env).

AIRFLOW_UID=50000

# Admin account for the web UI (http://localhost:8080), created by `docker compose up airflow-init`.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me

AIRFLOW__API_AUTH__JWT_SECRET=change-me-to-a-long-random-string
