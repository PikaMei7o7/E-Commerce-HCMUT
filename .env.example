# ============================================================
# DATABASE SERVER
# ============================================================
DB_HOST=YOUR_CLOUD_SQL_PUBLIC_IP
DB_PORT=5432
DB_NAME=your_database
# DB_SSLMODE=prefer

# --- Local PostgreSQL instead of Cloud SQL (see README, "Local database")
# DB_HOST=localhost
# DB_NAME=hm_ecommerce_local
# DB_SSLMODE=disable


# ============================================================
# 1. OWNER (admin): runs main.py, ETL, star schema load, grants
#    Needs CREATEROLE + ownership of the schemas. Sees everything.
# ============================================================
DB_USER=your_user
DB_PASSWORD=your_password
# Local: DB_USER=hm_owner / DB_PASSWORD=hm_owner_local_pw


# ============================================================
# 2. PRODUCT / SALES ANALYST  (role hm_product_sales_analyst)
#    Portal: Sales overview + Product performance. No customer data.
#    Local-only example password: change it on Cloud SQL.
# ============================================================
HM_PRODUCT_ANALYST_USER=hm_product_analyst_01
HM_PRODUCT_ANALYST_PASSWORD=product_local_pw


# ============================================================
# 3. CUSTOMER ANALYST  (role hm_customer_analyst)
#    Portal: Sales overview + Customer segments + Sales explorer.
#    No product-performance views, no postal_code.
#    Local-only example password: change it on Cloud SQL.
# ============================================================
HM_CUSTOMER_ANALYST_USER=hm_customer_analyst_01
HM_CUSTOMER_ANALYST_PASSWORD=customer_local_pw
